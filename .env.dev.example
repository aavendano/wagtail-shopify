# Copia a .env.dev (no se commitea). No uses el .env de producción.
# Arranque: Daphne :8083 con config.settings_dev + SQLite (no Postgres).

DJANGO_SETTINGS_MODULE=config.settings_dev
DJANGO_DEBUG=true
DJANGO_SECRET=dev-secret-change-me

# SQLite de desarrollo (archivo). No apuntar a DB_NAME / Postgres.
DEV_SQLITE_NAME=/tmp/cms-shop-dev.sqlite3

# Content store: Postgres authoritative (mismo criterio que producción)
CONTENT_STORE_ENABLED=false
CONTENT_STORE_MODE=db
CONTENT_STORE_ROOT=/home/alejandro/apps/cms-shop/backend/content
CONTENT_STORE_GIT_FALLBACK_TO_DB=false
# Para probar Git authority: CONTENT_STORE_ENABLED=true + CONTENT_STORE_MODE=git_authoritative

# Shopify opcional en dev (deja vacío si solo pruebas CMS local)
SHOPIFY_APP_URL=http://127.0.0.1:8083
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=

# Celery inline en settings_dev; no hace falta Redis
# CELERY_TASK_ALWAYS_EAGER=true

# Mail: consola (stdout de Daphne). Para SMTP real, descomenta y rellena.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CMS Shop <noreply@cms.aadigitalbusiness.com>
