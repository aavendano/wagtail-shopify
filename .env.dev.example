# Copia a .env.dev (no se commitea). No uses el .env de producción.
# Arranque: Daphne :8083 con config.settings_dev + SQLite (no Postgres).

DJANGO_SETTINGS_MODULE=config.settings_dev
DJANGO_DEBUG=true
DJANGO_SECRET=dev-secret-change-me

# SQLite de desarrollo (archivo). No apuntar a DB_NAME / Postgres.
DEV_SQLITE_NAME=/tmp/cms-shop-dev.sqlite3

# Content store: BD manda + espejo Markdown bajo content/
CONTENT_STORE_ENABLED=true
CONTENT_STORE_MODE=mirror
CONTENT_STORE_ROOT=/home/alejandro/apps/cms-shop/backend/content
# CONTENT_STORE_GIT_FALLBACK_TO_DB=false

# Shopify opcional en dev (deja vacío si solo pruebas CMS local)
SHOPIFY_APP_URL=http://127.0.0.1:8083
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=

# Celery inline en settings_dev; no hace falta Redis
# CELERY_TASK_ALWAYS_EAGER=true
