#!/usr/bin/env bash
# Daphne entry point: import bigframes before twisted/daphne (zope.interface conflict).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PYTHON="$ROOT/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "error: missing $ROOT/.venv" >&2
  exit 1
fi

exec "$VENV_PYTHON" "$ROOT/bin/daphne_boot.py" "$@"
