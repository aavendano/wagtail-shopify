# Auto-prepend project venv to PATH when entering this directory (requires direnv).
# Without direnv: source .venv/bin/activate  OR  bin/pytest  OR  make test-glossary
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# Dev-only config from the shared vault (plt-devenv). Skipped if plt-devenv is not installed.
DEVENV="$HOME/Documents/Proyectos/playlovetoys/plt-devenv/bin/devenv"
if [ -x "$DEVENV" ]; then
  eval "$("$DEVENV" direnv wagtail-shopify)"
fi
dotenv_if_exists .env.local
