# Copia a .env en la raíz del repositorio.

# --- Django ---
DJANGO_SECRET=
DJANGO_DEBUG=false

# --- PostgreSQL (producción) ---
DB_NAME=wagtail_shopify
DB_USER=wagtail_shopify_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Shopify ---
# URL pública (debe coincidir con application_url en shopify.app.toml).
SHOPIFY_APP_URL=https://cms.aadigitalbusiness.com

# Client ID y secret (Partners). client_id también está en shopify.app.toml.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Mismos scopes que shopify.app.toml [access_scopes], separados por comas.
SHOPIFY_SCOPES=read_content,read_online_store_pages,write_content,write_online_store_pages,read_products,write_products,read_metaobjects,write_metaobjects,read_metaobject_definitions,write_metaobject_definitions,write_files

# --- MCP (django-ninja-mcp) ---
# Debe coincidir con una API key activa en Django Admin → API → API Keys.
MCP_DEFAULT_API_KEY=

# --- Wagtail AI (Gemini) ---
GEMINI_API_KEY=
# Semantic internal links (vector search). Requires pgvector on PostgreSQL — a superuser must run
# once: CREATE EXTENSION IF NOT EXISTS vector;  Then set WAGTAIL_AI_PGVECTOR=true and migrate.
# WAGTAIL_AI_PGVECTOR=true
# SEMANTIC_LINKS_AUTO_ON_PUBLISH=true
# SEMANTIC_LINKS_LIMIT_PER_TYPE=5
# SEMANTIC_LINKS_TYPE_OVERFETCH=10
# SEMANTIC_LINKS_INDEX_ON_PUBLISH=true
# SEMANTIC_LINKS_BACKFILL_SCHEDULE_ENABLED=true
# SEMANTIC_LINKS_BACKFILL_ONLY_MISSING=true

# --- Celery (Redis broker, DB 1 aislada de otras apps) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_DEFAULT_QUEUE=wagtail_shopify
CELERY_GSC_QUEUE=gsc_bigquery
# CELERY_TASK_ALWAYS_EAGER=true
# CMS_SHOP_LOAD_BIGFRAMES=1  # only on the GSC Celery unit (cms-shop-celery-gsc)

# --- Email (password reset de Django/Wagtail) ---
# Sin SMTP el formulario de reset parece correcto pero el correo no sale:
# no hay nada escuchando en localhost:25, y Django solo envía si el email
# coincide con User.email (p. ej. alejandro@playlovetoys.com, no un Gmail
# que no esté en la ficha del usuario).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CMS Shop <noreply@cms.aadigitalbusiness.com>

# --- Daphne ---
DAPHNE_BIND=127.0.0.1:8082

# --- Editorial content store (default producción: Postgres authoritative) ---
CONTENT_STORE_ENABLED=false
CONTENT_STORE_MODE=db
CONTENT_STORE_GIT_FALLBACK_TO_DB=false
# Alternativas: mirror | git_authoritative
# CONTENT_STORE_ROOT=/home/alejandro/apps/cms-shop/backend/content
#
# Desarrollo local (SQLite :8083): copia .env.dev.example → .env.dev
# y usa DJANGO_SETTINGS_MODULE=config.settings_dev (ver docs/cms-spa.md).

# --- BigQuery GSC ---
# Service account: cms-shop-live@aadigitalbusiness.iam.gserviceaccount.com
BIGQUERY_PROJECT_ID=aadigitalbusiness
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/home/alejandro/apps/cms-shop/backend/secrets/cms-shop-live.json
