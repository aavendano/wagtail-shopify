# Dev .env for Cloud Agent environments. Copied to ./.env by .cursor/install.sh
# when no .env exists. Self-contained: SQLite + Celery eager, no external services.
DJANGO_SECRET=dev-insecure-cloud-agent-key
DJANGO_DEBUG=true

# No DB_NAME -> Django falls back to SQLite (see config/settings.py).

# Run Celery tasks inline so no Redis broker / worker is required in dev.
CELERY_TASK_ALWAYS_EAGER=true

# Shopify credentials are intentionally empty in dev: outbound sync to Shopify
# is disabled, but Wagtail admin, the /cms/ SPA, the django-ninja API and the
# full pytest suite all run locally without them.
SHOPIFY_APP_URL=http://localhost:8000
