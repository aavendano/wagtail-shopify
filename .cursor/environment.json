{
  "name": "cms-shop-backend",
  "install": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "start": "true",
  "terminals": [
    {
      "name": "daphne",
      "command": ".venv/bin/daphne -b 0.0.0.0 -p 8000 config.asgi:application",
      "description": "Producción/Cloud: Django ASGI en http://0.0.0.0:8000 (config.settings + .env)"
    },
    {
      "name": "daphne-dev",
      "command": "export DJANGO_SETTINGS_MODULE=config.settings_dev DEV_SQLITE_NAME=/tmp/cms-shop-dev.sqlite3 && .venv/bin/python manage.py migrate --noinput && .venv/bin/daphne -b 127.0.0.1 -p 8083 config.asgi:application",
      "description": "Dev local: settings_dev + SQLite + content store mirror en http://127.0.0.1:8083"
    }
  ],
  "ports": [
    {
      "name": "wagtail-cloud",
      "port": 8000
    },
    {
      "name": "wagtail-dev",
      "port": 8083
    }
  ]
}
